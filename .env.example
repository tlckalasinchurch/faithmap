# PostgreSQL 16 connection URL (Neon in staging/production).
# Leave unset or set pglite://./.data/faithmap-pg for local PGlite PostgreSQL 16 engine.
DATABASE_URL=pglite://./.data/faithmap-pg

# Application URL (used for LINE Login OIDC callback)
APP_BASE_URL=http://localhost:3000

# Enable/disable demo account quick-switcher (development/pilot demo only)
FAITHMAP_DEMO_MODE=true

# LINE Login OIDC (DEC-03) - optional in local dev/demo
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# LINE OA Messaging API (DEC-07) - simulated delivery log when unset
LINE_OA_CHANNEL_ACCESS_TOKEN=

# Internal job & session signing secrets
CRON_SECRET=faithmap-dev-cron-secret-change-in-prod
AUTH_SESSION_PEPPER=faithmap-dev-session-pepper-change-in-prod
